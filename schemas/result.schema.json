{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pronunciation scoring result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "method_version",
    "phoneme_accuracy_summary",
    "words",
    "preprocessing",
    "warnings",
    "error"
  ],
  "properties": {
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "method_version": {
      "enum": [
        "gop-ridge-v1",
        "gop-hgb-mae-v2"
      ]
    },
    "phoneme_accuracy_summary": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "words": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/word"
      }
    },
    "preprocessing": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/preprocessing"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "phoneme_accuracy_summary": {
            "type": "number"
          },
          "words": {
            "minItems": 1
          },
          "preprocessing": {
            "$ref": "#/$defs/preprocessing"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "$ref": "#/$defs/error"
          },
          "phoneme_accuracy_summary": {
            "type": "null"
          },
          "words": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "phone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "index_in_word",
        "target",
        "start_seconds",
        "end_seconds",
        "score",
        "score_raw_0_2",
        "needs_practice"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "index_in_word": {
          "type": "integer",
          "minimum": 0
        },
        "target": {
          "enum": [
            "AA",
            "AE",
            "AH",
            "AO",
            "AW",
            "AY",
            "B",
            "CH",
            "D",
            "DH",
            "EH",
            "ER",
            "EY",
            "F",
            "G",
            "HH",
            "IH",
            "IY",
            "JH",
            "K",
            "L",
            "M",
            "N",
            "NG",
            "OW",
            "OY",
            "P",
            "R",
            "S",
            "SH",
            "T",
            "TH",
            "UH",
            "UW",
            "V",
            "W",
            "Y",
            "Z",
            "ZH"
          ]
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "score_raw_0_2": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "needs_practice": {
          "type": "boolean"
        }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "word",
        "phoneme_accuracy_summary",
        "phones"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "word": {
          "type": "string",
          "minLength": 1
        },
        "phoneme_accuracy_summary": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "phones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/phone"
          }
        }
      }
    },
    "preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sample_rate",
        "duration_seconds",
        "original_duration_seconds",
        "leading_trim_seconds",
        "trailing_trim_seconds",
        "gain_db",
        "already_preprocessed"
      ],
      "properties": {
        "version": {
          "const": "kevin-16k-rms25-peak1-edge500-v1"
        },
        "sample_rate": {
          "const": 16000
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "original_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "leading_trim_seconds": {
          "type": "number",
          "minimum": 0
        },
        "trailing_trim_seconds": {
          "type": "number",
          "minimum": 0
        },
        "gain_db": {
          "type": "number"
        },
        "already_preprocessed": {
          "type": "boolean"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid_audio",
            "no_speech",
            "invalid_reference",
            "model_not_ready",
            "backend_unavailable",
            "backend_timeout",
            "alignment_failed",
            "evidence_missing"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
