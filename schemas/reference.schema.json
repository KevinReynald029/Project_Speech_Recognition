{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pronunciation reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["reference_words"],
  "properties": {
    "reference_words": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["word", "phones"],
        "properties": {
          "word": {"type": "string", "minLength": 1},
          "phones": {
            "type": "array", "minItems": 1,
            "items": {"enum": ["AA", "AE", "AH", "AO", "AW", "AY", "B", "CH", "D", "DH", "EH", "ER", "EY", "F", "G", "HH", "IH", "IY", "JH", "K", "L", "M", "N", "NG", "OW", "OY", "P", "R", "S", "SH", "T", "TH", "UH", "UW", "V", "W", "Y", "Z", "ZH"]}
          }
        }
      }
    }
  }
}
